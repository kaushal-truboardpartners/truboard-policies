# ====================================================================
# TruBoard Policies — environment template
# Copy to `.env` and fill in. The backend fails loudly at startup if a
# required secret is missing (pydantic-settings, no defaults on secrets).
# ====================================================================

# ---- Azure OpenAI ----
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ---- Azure Blob Storage ----
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=truboard-policies

# ---- Database ----
# Inside docker-compose the host is the service name `db`.
DATABASE_URL=postgresql+asyncpg://truboard:truboard@db:5432/truboard_policies

# ---- OAuth / Auth ----
# Base URL of the OAuth/OIDC provider (e.g. https://idp.truboard.com)
OAUTH_INTROSPECT_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
ALLOWED_ORIGIN=http://localhost:5173

# Dev-mode auth bypass: when true, token introspection is skipped and the current
# user is resolved from the `X-Dev-User` header (email) against seeded users.
# MUST be false in production.
AUTH_DEV_MODE=true
AUTH_DEV_DEFAULT_USER=admin@truboard.com

# ---- RAG / retrieval config ----
RATE_LIMIT_QUERIES=30
RATE_LIMIT_WINDOW_SECONDS=3600
MAX_UPLOAD_SIZE_MB=50
SAS_TOKEN_EXPIRY_HOURS=1
RETRIEVAL_CONFIDENCE_THRESHOLD=0.75
RETRIEVAL_SCOPED_TOP_K=3
RETRIEVAL_GLOBAL_TOP_K=5
DEDUP_COSINE_THRESHOLD=0.97
CONTEXT_TOKEN_BUDGET=6000
LLM_MAX_OUTPUT_TOKENS=800
LLM_TIMEOUT_SECONDS=15

# ---- Frontend (Vite — prefix VITE_) ----
VITE_API_BASE_URL=http://localhost:8000
VITE_OAUTH_AUTHORITY=
VITE_OAUTH_CLIENT_ID=
VITE_OAUTH_CLIENT_SECRET=
VITE_OAUTH_DOMAIN_URL=http://localhost:5173
VITE_DEV_USER=admin@truboard.com
